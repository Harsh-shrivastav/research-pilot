# Copy to backend/.env (the backend reads .env from the directory it runs in).
# Every value below is the default; delete any line you don't need to change.

# --- Database / server ------------------------------------------------------
# SQLite for local dev. For PostgreSQL + pgvector:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/researchpilot
DATABASE_URL=sqlite:///./researchpilot.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Document processing ----------------------------------------------------
# auto | docling | pymupdf | pdfplumber
# "auto" uses the first installed of docling -> pymupdf -> pdfplumber.
PARSER_BACKEND=auto

# OCR for scanned / image-only pages (needs the tesseract binary on PATH).
ENABLE_OCR=true
OCR_DPI=200
MAX_OCR_PAGES=50

# In-process background workers. Set to 0 and run `python -m app.worker`
# to process documents in a separate process instead.
WORKER_COUNT=2

# --- AI providers -------------------------------------------------------------
# "local" needs no API key and no network access (hashing embedder +
# extractive generator), so the app works end-to-end out of the box.
# Options: local | gemini | openai | voyage  (embeddings)
#          local | gemini | openai | anthropic  (llm)
# For the hackathon: EMBEDDING_PROVIDER=gemini and LLM_PROVIDER=gemini.
# Defaults when the *_MODEL lines are empty: gemini-embedding-001 and gemini-3.8-flash.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=
LLM_PROVIDER=local
LLM_MODEL=

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Max in-flight Gemini calls per process, shared by embeddings + LLM.
GEMINI_MAX_CONCURRENCY=4
# Embedding texts sent per minute, per process. Free tier allows 100/min and
# counts every text in a batch; set 0 to disable pacing on a paid tier.
GEMINI_EMBED_TEXTS_PER_MINUTE=90
# Models to switch to when LLM_MODEL has no quota left or is overloaded
# (comma-separated). Unset = built-in list; empty = no fallback.
# LLM_FALLBACK_MODELS=
# How much a thinking model reasons before answering. "minimal" is several
# times faster and enough for answering from retrieved passages; empty = the
# model's own default.
GEMINI_THINKING_LEVEL=minimal
# Comparison cells are independent LLM calls; run this many at once.
COMPARISON_MAX_PARALLEL=4
# How a comparison fills its cells. Unset = auto: "structured" for Gemini
# (ONE long-context call per paper fills every dimension as JSON, each answer
# backed by a quote the backend verifies against the paper's stored text),
# "per_cell" for every other provider (one retrieval + one call per cell).
# A paper whose structured call fails falls back to per_cell for that paper.
# COMPARISON_MODE=structured
# Structured mode sends the whole paper when it is at most this many
# characters (~4 chars per token); longer papers send only the top retrieved
# passages per dimension.
COMPARISON_FULL_PAPER_MAX_CHARS=250000
# true: an answer whose quote cannot be verified shows "not found" instead.
# false: the answer is kept but flagged quote_verified=false.
COMPARISON_STRICT_QUOTES=true
# Also accept a quote whose words appear in the page text in order within a
# bounded window. Two-column PDFs are often extracted with the columns
# interleaved, so a model's correctly ordered quote is not a literal
# substring. false = exact substrings only.
COMPARISON_TOLERANT_QUOTES=true
# After a matrix is filled, judge whether the papers are directly comparable
# (same dataset / metric / task / split / setup) and say exactly why not.
# The rules always run and work with any LLM_PROVIDER, including local.
COMPARABILITY_ENABLED=true
# Let the LLM decide the aspects the rules cannot (ambiguous cell text). Unset
# = auto: Gemini only. false = rules only.
# COMPARABILITY_USE_LLM=false

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# --- Chunking + retrieval -----------------------------------------------------
CHUNK_CHILD_TOKENS=320
CHUNK_CHILD_OVERLAP_TOKENS=60
CHUNK_PARENT_TOKENS=1400
RETRIEVAL_TOP_K=6
RETRIEVAL_MAX_CONTEXT_CHARS=14000
# Optional pre-LLM gate: if a paper's best retrieval score is below this,
# answer "not found" without calling the LLM. 0 = off. Choose it from data:
#   python -m scripts.print_score_distribution <document_id> questions.txt
RETRIEVAL_MIN_SCORE=0.0
CHAT_HISTORY_TURNS=6

# Workspace chat: the LLM rewrites the question into one sub-query per paper
# before retrieval. Unset = auto (on for LLM_PROVIDER=gemini only).
# QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_TIMEOUT_SECONDS=20
# Each workspace paper contributes at least this many chunks to the context.
WORKSPACE_MIN_CHUNKS_PER_PAPER=2

# "hybrid" = parallel vector + BM25 keyword search, fused with Reciprocal
# Rank Fusion, then reranked. "vector_only" = vector search alone.
RETRIEVAL_MODE=hybrid
RETRIEVAL_CANDIDATE_POOL_SIZE=20
RETRIEVAL_RRF_K=60
RETRIEVAL_ENABLE_RERANKING=true
RERANK_PROVIDER=local

# Retrieval Debug panel (query + every candidate's vector/keyword/fusion/
# rerank score). Development/admin only — leave false in normal use.
DEBUG_MODE=false
